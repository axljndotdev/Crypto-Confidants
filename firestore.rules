rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Site content (Hero, Why We Exist, Who We Help, Offerings, Comms, Pricing, etc.)
    match /siteContent/{document} {
      allow read: if true;
      allow write: if true;
    }
    
    // Newsletters collection
    match /newsletters/{newsletterId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin staff accounts
    match /adminUsers/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Fallback default rule
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
